    <h3>Simple Table</h3>
    <Table>
        <TableCaption>A list of your recent invoices.</TableCaption>
        <TableHeader>
            <TableRow>
                <TableHead>Invoice</TableHead>
                <TableHead>Status</TableHead>
                <TableHead>Method</TableHead>
                <TableHead class="text-right">Amount</TableHead>
            </TableRow>
        </TableHeader>
        <TableBody>
            @foreach (var i in Enumerable.Range(0, 5))
            {
                <TableRow @key="i">
                    <TableCell class="font-medium">INV001</TableCell>
                    <TableCell>Paid</TableCell>
                    <TableCell>Credit Card</TableCell>
                    <TableCell class="text-right">$250.00</TableCell>
                </TableRow>
            }
        </TableBody>
    </Table>

</Container>

@code {
    [Inject] public IToastService ToastService { get; set; } = default!;

    private async Task UserDelete(ExampleData data) {
        Task.Run(async () => await ToastService.UserPreventable(new UserPreventableOptions {
            Loading = $"Deleting {data.Name}",
            Description = $"{data.Name} will be removed from your team",
            OnInitial = async (token) => {
                List.Remove(data);
                await InvokeAsync(StateHasChanged);
            },
            OnFailure = async (token) => {
                List.Add(data);
                await InvokeAsync(StateHasChanged);
            }
        }));
        await Task.CompletedTask;
    }

    private int Counter = 0;
    private async Task Started(CancellationToken token) {
        Counter = 0;
        await InvokeAsync(StateHasChanged);
    }

    private Task Completed(CancellationToken token) {
        Counter = Random.Shared.Next(200, 2000);
        InvokeAsync(StateHasChanged);
        return Task.CompletedTask;
    }

    private Task Error(CancellationToken token) {
        Counter = -200;
        InvokeAsync(StateHasChanged);
        return Task.CompletedTask;
    }

    private async Task FirePreventable() {
        var a = await ToastService.UserPreventable(new UserPreventableOptions {
            Loading = "Sorting your stuff out",
            Description = "We are doing stuff in the background",
            OnInitial = Started,
            OnSuccess = Completed,
            OnFailure = Error
        });
    }


    private class ExampleData {
        public string? Name { get; set; }
        public int Age { get; set; }
        public string? Nickname { get; set; }
        public int Rating { get; set; }
    }

