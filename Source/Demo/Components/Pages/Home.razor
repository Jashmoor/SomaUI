@using SomaUI
@using Dialogs
@rendermode InteractiveServer
@page "/"

@code {
    [Inject] private IToastService ToastService { get; set; } = default!;
    [Inject] private IPopupService PopupService { get; set; } = default!;
    [Inject] private DialogService DialogService { get; set; } = default!;
    [Inject] private SheetService SheetService { get; set; } = default!;

    private string? ToggleValue { get; set; } = "one";

    private async Task OpenSheet(SheetSide? side = null) {
        var a = await SheetService.ShowAsync<DemoSheet, bool?>(new(), new SheetOptions {
            Title = "Test",
            Description = "Description",
            Side = side ?? SheetSide.Right
        });
    }

    private bool StartRunning = false;
    private async Task TestDelay(CancellationToken token)
        => await Task.Delay(1000, token);

    private async Task OpenSheetRight()
        => await OpenSheet();
    private async Task OpenSheetLeft()
        => await OpenSheet(SheetSide.Left);
    private async Task OpenSheetTop()
        => await OpenSheet(SheetSide.Top);
    private async Task OpenSheetBottom()
        => await OpenSheet(SheetSide.Bottom);

    private async Task Confirmation() {
        var a = await DialogService.ShowAsync<DemoDialog, bool?>(
            new()
        );
        await (a switch {
            true => ToastService.Promise(
                async () => await Task.Delay(3000),
                new ToastPromiseOptions {
                    Loading = "Uploading Secret Stuff ...",
                    Success = "Thanks we got it all",
                }),
            _ => ToastService.Toast("You declined", ToastType.Default),
        });
    }

    private async Task ShowEmpty() {
        var a = await DialogService.ShowOption();
    }

    private async Task<bool?> Interrupt()
        => await DialogService.ShowAsync<DemoDialog, bool?>(new(), new DialogOptions {
            Title = "I interrupted you",
            Description = "this is to test the async functionality of the trace",
            Dismissable = false
        });

    private async Task ShowModel() {
        var a = await DialogService.ShowAsync<DemoDialog, bool?>(new(), new DialogOptions {
            Title = "Alternate Title",
            Description = "Alternate Description",
            Dismissable = false
        });
        if (a == true)
        {
            await ToastService.Toast(
                $"Custom Error : {a}",
                ToastType.Error,
                (options) => {
                    options.Description = "Something went really wrong";
                }
            );
        }
    }

    private List<TraceModel> Items => [
        new(){
            Title = "Save Your Changes",
            Description = "Click to begin",
            Action = TraceAction.Executable,
            Status = TraceStatus.Pending,
            AsyncAction = async (item) => {
                item.Description = "Querying database ...";
                await Task.Delay(3000);
                item.Description = $"Prepping : {Random.Shared.Next(0, 20)}";
            },
            Children = [
        new(){
            Title = "Saving Changes",
            Description = "We will modify your changes",
            Action = TraceAction.Executable,
            Status = TraceStatus.Pending,
            AsyncAction = async (item) => {
                item.Description = "Updating database ...";
                await Task.Delay(3000);
                var a = await Interrupt();
                if(a == false) {
                    item.Status = TraceStatus.Error;
                    throw new Exception("DENIED");
                }
                item.Description = $"Changes Saved : {Random.Shared.Next(0, 20)}";
            },
            Children = [
                       new(){
            Title = "Fetching Data",
            Action = TraceAction.Collapsible,
            Status = TraceStatus.Pending,
            DefaultOpen = true,
            AsyncAction = async (item) => {
                item.Description = "Reloading Profile ...";
                await Task.Delay(3000);
                await ToastService.Toast("Loaded", ToastType.Success);
                item.Description = $"User Loaded : {Random.Shared.Next(0, 20)}";
            },
            Children = [
                                new(){
            Title = "Saving Changes",
            Description = "We will modify your changes",
            Action = TraceAction.Executable,
            Status = TraceStatus.Pending,
            AsyncAction = async (item) => {
                item.Description = "Updating database ...";
                await Task.Delay(3000);
                await ToastService.Toast("Loaded", ToastType.Success);
                item.Description = $"Changes Saved : {Random.Shared.Next(0, 20)}";
            },
            Children = [
                       new(){
            Title = "Fetching Data",
            Action = TraceAction.Executable,
            Status = TraceStatus.Pending,
            AsyncAction = async (item) => {
                item.Description = "Reloading Profile ...";
                await Task.Delay(3000);
                item.Description = $"User Loaded : {Random.Shared.Next(0, 20)}";
            }
    }
            ]
    }
]
    },

]
    },

]
    }
    ];
}

