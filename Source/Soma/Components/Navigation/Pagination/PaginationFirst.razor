@namespace SomaUI
@inherits BaseWithChildComponent

<PaginationLink Disabled="@Disabled" OnClick="HandleClick">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" fill="currentColor"><path d="M240-240v-480h80v480h-80Zm440 0L440-480l240-240 56 56-184 184 184 184-56 56Z" /></svg>
</PaginationLink>

@code {
    [CascadingParameter] internal PaginationContext? Context { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }

    private async Task HandleClick() {
        if (Context?.State is not null)
        {
            Context.State.FirstPage();
            if (Context.OnPageChanged is not null)
                await Context.OnPageChanged(Context.State.CurrentPage);
        }
        if (OnClick.HasDelegate)
            await OnClick.InvokeAsync();
    }
}
