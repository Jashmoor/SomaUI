@namespace SomaUI
@using Microsoft.AspNetCore.Components.Sections
@inherits BaseWithChildComponent

@if (_isActive)
{
    <SectionContent SectionId="FloatingHost.GuidedTour">
        <div tour-blocker @onclick:stopPropagation="true"></div>
        <TourPopup Attach="@Attach"
                   Title="@Title"
                   Description="@Description"
                   StepNumber="@Parent.StepNumber"
                   StepCount="@Parent.StepCount"
                   IsLast="@Parent.IsLastStep"
                   Padding="@Padding"
                   OnNext="Parent.NextAsync"
                   OnCancel="Parent.CancelAsync"
                   Placement="@Placement">
            @ChildContent
        </TourPopup>
    </SectionContent>
}

@code {
    [CascadingParameter] public GuidedTour Parent { get; set; } = default!;

    [Parameter] public string Attach { get; set; } = string.Empty;
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Description { get; set; } = string.Empty;
    [Parameter] public int Order { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Placement { get; set; } = "bottom";
    [Parameter] public int Padding { get; set; } = 0;

    private bool _isActive;

    protected override void OnInitialized() {
        base.OnInitialized();
        Parent.Register(this);
        Parent.Changed += OnTourChanged;
    }

    private void OnTourChanged() {
        var active = ReferenceEquals(Parent.ActiveItem, this);
        if (active == _isActive) return;
        _isActive = active;
        _ = InvokeAsync(StateHasChanged);
    }

    public new void Dispose() {
        Parent.Changed -= OnTourChanged;
        Parent.Unregister(this);
        base.Dispose();
    }
}
