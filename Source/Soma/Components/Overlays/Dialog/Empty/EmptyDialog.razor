@namespace SomaUI

<DialogHeader>
    <DialogTitle>@Context.Reference.Options.Title</DialogTitle>
    <DialogDescription>@Context.Reference.Options.Description</DialogDescription>
</DialogHeader>
<DialogBody>
</DialogBody>
<DialogFooter>
    <Button OnClick="Confirmation">Confirm</Button>
    <Button OnClick="Cancellation">Cancel</Button>
</DialogFooter>

@code {
    [CascadingParameter] public DialogContext Context { get; set; } = default!;

    private async Task Confirmation() {
        Context.Close(true);
    }

    private async Task Cancellation() {
        Context.Close(false);
    }
}