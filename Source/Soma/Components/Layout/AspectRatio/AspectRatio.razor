@namespace SomaUI
@using System.Globalization
@inherits BaseWithChildComponent

<figure @attributes="Attributes" aspect-ratio style="@GetStyle()">
    @ChildContent
</figure>

@code {
    [Parameter] public double Ratio { get; set; } = 1.0;

    private string GetStyle() {
        var style = $"aspect-ratio: {Ratio.ToString(CultureInfo.InvariantCulture)};";

        if (Attributes?.TryGetValue("style", out var userStyle) == true)
            return $"{style} {userStyle}";

        return style;
    }
}
