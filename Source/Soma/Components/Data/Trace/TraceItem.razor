@namespace SomaUI
@using SomaUI.Tracing
@inherits BaseWithChildComponent

@foreach (var item in Items)
{
    @if (item.Action == TraceAction.Executable)
    {

        <li>
            <Item style="@(item.Status == TraceStatus.Pending ? "--ds-color: var(--color-neutral-500);" : "")">
                <ItemContent>
                    <ItemTitle>@item.Title</ItemTitle>
                    <ItemDescription>
                        @if (item.Status == TraceStatus.Running || item.Status == TraceStatus.Finished)
                        {
                            <Thinking Text="@item.Description" />
                        }
                    </ItemDescription>
                </ItemContent>
                <ItemActions>
                    @if (item.Status == TraceStatus.Pending)
                    {
                    }
                    else
                    {
                        <div style="display: flex; gap: var(--spacing-xs); align-items: center; color: @(item.Status == TraceStatus.Running ? "var(--muted-foreground)" : "var(--card-foreground)");" animate fade-in>
                            @if (item.Status == TraceStatus.Running)
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" fill="var(--card-foreground)"><path d="M480-80q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 27-3 53t-10 51q-14-16-32.5-27T794-418q3-15 4.5-30.5T800-480q0-134-93-227t-227-93q-134 0-227 93t-93 227q0 134 93 227t227 93q51 0 97.5-15t85.5-42q12 17 29.5 30t37.5 20q-51 41-114.5 64T480-80Zm254.5-174.5Q720-269 720-290t14.5-35.5Q749-340 770-340t35.5 14.5Q820-311 820-290t-14.5 35.5Q791-240 770-240t-35.5-14.5ZM612-292 440-464v-216h80v184l148 148-56 56Z" /></svg>
                            }
                            @if (item.Status == TraceStatus.Error)
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" fill="var(--error)"><path d="M508.5-291.5Q520-303 520-320t-11.5-28.5Q497-360 480-360t-28.5 11.5Q440-337 440-320t11.5 28.5Q463-280 480-280t28.5-11.5ZM440-440h80v-240h-80v240Zm40 360q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm0-80q134 0 227-93t93-227q0-134-93-227t-227-93q-134 0-227 93t-93 227q0 134 93 227t227 93Zm0-320Z" /></svg>
                            }
                            @if (item.Status == TraceStatus.Finished)
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" fill="var(--success)"><path d="M480-80q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q65 0 123 19t107 53l-58 59q-38-24-81-37.5T480-800q-133 0-226.5 93.5T160-480q0 133 93.5 226.5T480-160q133 0 226.5-93.5T800-480q0-18-2-36t-6-35l65-65q11 32 17 66t6 70q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm-56-216L254-466l56-56 114 114 400-401 56 56-456 457Z" /></svg>
                            }
                            <div class="caption">
                                @item.Status.ToString().ToLower()
                            </div>
                        </div>
                    }
                </ItemActions>
            </Item>
        </li>
    }

    @if (item.Action == TraceAction.Collapsible)
    {
        <Trace>
            <TraceCollapsible Open="@item.DefaultOpen">
                <TraceCollapsibleTrigger>Button</TraceCollapsibleTrigger>
                <TraceCollapsibleContent>
                    @item.Description
                </TraceCollapsibleContent>
            </TraceCollapsible>
        </Trace>

    }
    @if (item.Children.Any())
    {
        <li>
            <ul>

                <TraceItem Items="@item.Children" />
            </ul>
        </li>
    }
}

@code {
    [Parameter] public List<TraceModel> Items { get; set; } = [];
}
