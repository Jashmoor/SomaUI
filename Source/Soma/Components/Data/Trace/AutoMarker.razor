@namespace SomaUI
@implements IDisposable

<div auto-marker style="opacity: @(_loading ? "0.5" : "1");">
    @if (_loading)
    {
        <Spinner />
    }
    else if (_hasError)
    {
        <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#e3e3e3"><path d="M508.5-291.5Q520-303 520-320t-11.5-28.5Q497-360 480-360t-28.5 11.5Q440-337 440-320t11.5 28.5Q463-280 480-280t28.5-11.5ZM440-440h80v-240h-80v240Zm40 360q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm0-80q134 0 227-93t93-227q0-134-93-227t-227-93q-134 0-227 93t-93 227q0 134 93 227t227 93Zm0-320Z" /></svg>
    }
    else if (!_ran)
    {
        <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#e3e3e3"><path d="M480-480ZM282-282q-82-82-82-198t82-198q82-82 198-82t198 82q82 82 82 198t-82 198q-82 82-198 82t-198-82Zm339.5-56.5Q680-397 680-480t-58.5-141.5Q563-680 480-680t-141.5 58.5Q280-563 280-480t58.5 141.5Q397-280 480-280t141.5-58.5Z" /></svg>
    }
    else
    {
        <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#e3e3e3"><path d="M268-240 42-466l57-56 170 170 56 56-57 56Zm226 0L268-466l56-57 170 170 368-368 56 57-424 424Zm0-226-57-56 198-198 57 56-198 198Z" /></svg>
    }
    <p shimmer="@(_loading)">
        @if (_loading)
        {
            @(Loading ?? "Running...")
        }
        else if (_hasError)
        {
            @(error)
        }
        else if (!_ran)
        {
            @(Message ?? "Ready")
        }
        else
        {
            @(Completed ?? "Completed")
        }
    </p>
</div>

@code {
    [Parameter, EditorRequired] public string Message { get; set; }
    [Parameter] public string? Loading { get; set; }
    [Parameter] public string? Completed { get; set; }
    [Parameter] public bool Start { get; set; } = false;
    [Parameter, EditorRequired] public Func<CancellationToken, Task> Habit { get; set; } = default!;
    [Parameter] public int Interval { get; set; } = 3;

    private bool _ran = false;
    private bool _loading = false;
    private bool _hasError = false;
    private string? error = "Error";

    private CancellationTokenSource? _cts;
    private bool _previousStart;

    protected override void OnInitialized() {
        _previousStart = Start;
        if (Start)
            StartLoop();
    }

    protected override async Task OnParametersSetAsync() {
        if (Start != _previousStart)
        {
            _previousStart = Start;

            if (Start)
                StartLoop();
            else
                StopLoop();
        }
        _ran = false;
        await base.OnParametersSetAsync();
    }

    private void StartLoop() {
        StopLoop();
        _cts = new CancellationTokenSource();
        _ = RunPeriodicTaskAsync(_cts.Token);
    }

    private void StopLoop() {
        if (_cts != null)
        {
            _cts.Cancel();
            _cts.Dispose();
            _cts = null;
        }
    }

    private async Task RunPeriodicTaskAsync(CancellationToken token) {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(Interval));
        try
        {
            while (!token.IsCancellationRequested && await timer.WaitForNextTickAsync(token))
            {
                try
                {
                    _loading = true;
                    _hasError = false;
                    error = null;
                    await InvokeAsync(StateHasChanged);
                    await Habit(token);
                    _ran = true;
                }
                catch (OperationCanceledException)
                {
                    return;
                }
                catch (Exception ex)
                {
                    _hasError = true;
                    error = ex?.Message ?? ex?.InnerException?.Message ?? "Error";
                }
                finally
                {
                    _loading = false;
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    public void Dispose() {
        StopLoop();
        GC.SuppressFinalize(this);
    }
}
