@namespace SomaUI
@inherits BaseWithChildComponent

<th th @attributes="Attributes" @ref="Element" @onclick="OnClickHandler">
    @ChildContent
</th>

@code {
    [Parameter] public EventCallback<TableHead> OnClick { get; set; }
    [Parameter] public string Title { get; set; }

    private async Task OnClickHandler() {
        if (OnClick.HasDelegate)
            await OnClick.InvokeAsync(this);
    }
}
