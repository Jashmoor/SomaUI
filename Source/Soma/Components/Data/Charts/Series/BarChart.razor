@namespace SomaUI
@using System.Globalization


@if (context != null)
{
    @if (context.CategoryScale != null && context.ValueScale != null)
    {
        var categories = context.CategoryScale.Domain;
        var isHorizontal = Layout == BarLayout.Horizontal;

        @for (int i = 0; i < categories.Count; i++)
        {
            var idx = i;
            var cat = categories[i];
            var zoneX = context.CategoryScale.Scale(cat);
            var zoneW = context.CategoryScale.Bandwidth;
            double tipX, tipY;
            if (isHorizontal)
            {
                double farX = context.PlotLeft;
                if (idx < context.Data.Count)
                {
                    foreach (var key in context.Config.Keys)
                    {
                        var x = context.ValueScale.Scale(DataAccessor.GetDouble(context.Data[idx], key));
                        if (x > farX)
                            farX = x;
                    }
                }
                tipX = farX;
                tipY = zoneX + zoneW / 2;
            }
            else
            {
                double topY = context.PlotBottom;
                if (idx < context.Data.Count)
                {
                    foreach (var key in context.Config.Keys)
                    {
                        var val = DataAccessor.GetDouble(context.Data[idx], key);
                        var y = context.ValueScale.Scale(val);
                        if (y < topY) topY = y;
                    }
                }
                tipX = zoneX + zoneW / 2;
                tipY = topY;
            }

            <rect x="@F(isHorizontal ? context.PlotLeft : zoneX)"
                  y="@F(isHorizontal ? zoneX : context.PlotTop)"
                  width="@F(isHorizontal ? context.PlotRight - context.PlotLeft : zoneW)"
                  height="@F(isHorizontal ? zoneW : context.PlotBottom - context.PlotTop)"
                  fill="transparent"
                  data-bar
                  @onmouseenter="@(() => context.SetActiveIndex(idx, zoneX + zoneW / 2, tipY))" />
        }
    }
    @ChildContent
}

@code {
    [CascadingParameter(Name = "_context")]
    private ChartContext? context { get; set; }

    [CascadingParameter] internal ChartDisplay Chart { get; set; } = default!;

    [Parameter, EditorRequired]
    public IReadOnlyList<object> Data { get; set; } = [];

    [Parameter]
    public ChartMargin? Margin { get; set; }

    [Parameter]
    public BarLayout Layout { get; set; } = BarLayout.Horizontal;

    [Parameter]
    public string? XDataKey { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    internal List<string> BarDataKeys { get; } = [];

    private IReadOnlyList<object>? _previousData;

    protected override void OnParametersSet() {
        if (context == null) return;

        if (_previousData != Data)
        {
            context.__Version++;
            _previousData = Data;
        }

        var margin = Margin ?? new ChartMargin();
        context.Width = Chart?.Width ?? 0;
        context.Height = Chart?.Height ?? 0;
        context.Margin = margin;
        context.BarLayout = Layout;
        context.Data = Data;
        context.XDataKey = XDataKey;

        BuildScales();
    }

    private void BuildScales() {
        bool isHorizontal = Layout == BarLayout.Horizontal;

        if (context == null || Data.Count == 0) return;

        var xKey = context.XDataKey ?? XDataKey;
        if (string.IsNullOrEmpty(xKey) && Data.Count > 0)
            xKey = "name";

        var categories = DataAccessor.GetAllStrings(Data, xKey!);
        if (isHorizontal)
        {
            context.YBandScale = new ScaleBand(categories, context.PlotTop, context.PlotBottom, 0.2, 0.1);
            context.XBandScale = null;
        }
        else
        {
            context.XBandScale = new ScaleBand(categories, context.PlotLeft, context.PlotRight, 0.2, 0.1);
            context.YBandScale = null;
        }
        context.XDataKey = xKey;

        double yMin = 0, yMax = 0;
        foreach (var key in context.Config.Keys)
        {
            var values = DataAccessor.GetAllDoubles(Data, key);
            foreach (var v in values)
            {
                if (v > yMax) yMax = v;
                if (v < yMin) yMin = v;
            }
        }

        var (niceMin, niceMax) = ChartMath.NiceExtent(yMin, yMax);
        if (isHorizontal)
        {
            context.XLinearScale = new ScaleLinear(niceMin, niceMax, context.PlotLeft, context.PlotRight);
            context.YScale = null;
        }
        else
        {
            context.YScale = new ScaleLinear(niceMin, niceMax, context.PlotBottom, context.PlotTop);
            context.XLinearScale = null;
        }
    }

    private void HandleMouseLeave(MouseEventArgs e) {
        context?.ClearActiveIndex();
    }

    private static string F(double v) => v.ToString("G6", CultureInfo.InvariantCulture);
}