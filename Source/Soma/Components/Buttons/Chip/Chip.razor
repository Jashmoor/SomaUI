@namespace SomaUI
@inherits BaseWithChildComponent
@implements IDisposable

<button chip type="button" @onclick="HandleClick" disabled="@IsDisabled" selected="@IsSelected">
    @if (IsSelected)
    {
        @if (Icon != null)
        {
            @Icon
        }
        else
        {
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" fill="currentColor">
                <path d="M400-304 240-464l56-56 104 104 264-264 56 56-320 320Z" />
            </svg>
        }
    }
    @ChildContent
</button>


@code {
    [CascadingParameter] internal ChipContext SetContext { get; set; } = default!;
    [Parameter] public RenderFragment? Icon { get; set; } = default!;
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter] public object? Value { get; set; }
    [Parameter] public bool Disabled { get; set; }

    internal void NotifySetStateChanged() => StateHasChanged();

    private bool IsDisabled => Disabled || (SetContext?.Disabled ?? false);
    private bool IsSelected => (SetContext?.IsSelected(Value) ?? false);

    private async Task HandleClick(MouseEventArgs args) {
        if (IsDisabled)
            return;

        if (SetContext is not null)
        {
            await SetContext.ToggleAsync(Value);
        }

        if (OnClick.HasDelegate)
            await OnClick.InvokeAsync(args);
    }

    public override void Dispose() {
        SetContext?.UnRegister(this);
        GC.SuppressFinalize(this);
        base.Dispose();
    }
}
